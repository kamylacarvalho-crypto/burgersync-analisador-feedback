# BurgerSync - Configurações de Ambiente

# Google Gemini API
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# GitHub Personal Token (para deploy e sincronização)
GITHUB_PERSONAL_TOKEN=seu_token_github_aqui

# Configurações Opcionais de SMTP para Disparo de E-mails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_RECIPIENT=gerencia.burgersync@gmail.com

# Porta do Servidor Local
PORT=8000
